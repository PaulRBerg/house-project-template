set default-list := true
set dotenv-load := false
set unstable := true
set lists := true

repo_root := justfile_directory() / ".."
supplemental_ox_paths := [
    ".prettierrc.mjs",
    ".vscode/settings.json",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "package.json",
]

# Check supplemental workspace scripts and configuration with Oxlint and Oxfmt.
# The budget app is covered by `just check`; pass `budget` explicitly for a standalone Ox check.
[group("checks")]
[positional-arguments]
@ox-check +paths=supplemental_ox_paths:
    cd "{{repo_root}}" && ./node_modules/.bin/oxlint --format agent --config oxlint.config.ts --no-error-on-unmatched-pattern "$@"
    cd "{{repo_root}}" && ./node_modules/.bin/oxfmt --check --config oxfmt.config.ts --no-error-on-unmatched-pattern "$@"
alias oc := ox-check

# Apply Oxlint's safe fixes and formatting to supplemental workspace scripts and configuration.
[group("checks")]
[positional-arguments]
@ox-write +paths=supplemental_ox_paths:
    cd "{{repo_root}}" && ./node_modules/.bin/oxlint --fix --format agent --config oxlint.config.ts --no-error-on-unmatched-pattern "$@"
    cd "{{repo_root}}" && ./node_modules/.bin/oxfmt --write --config oxfmt.config.ts --no-error-on-unmatched-pattern "$@"
alias ow := ox-write

default:
    @just --list

[positional-arguments]
@dev *args:
    ./node_modules/.bin/vite "$@"

[positional-arguments]
@preview *args:
    ./node_modules/.bin/vite preview "$@"

@format:
    cd "{{repo_root}}" && ./node_modules/.bin/oxfmt --config oxfmt.config.ts --write budget
    ./node_modules/.bin/prettier --write "**/*.{md,yml,yaml}"

@format-prose:
    ./node_modules/.bin/prettier --write "**/*.{md,yml,yaml}"

@format-check:
    cd "{{repo_root}}" && ./node_modules/.bin/oxfmt --config oxfmt.config.ts --check budget
    ./node_modules/.bin/prettier --check "**/*.{md,yml,yaml}"

@format-prose-check:
    ./node_modules/.bin/prettier --check "**/*.{md,yml,yaml}"

@lint:
    cd "{{repo_root}}" && ./node_modules/.bin/oxlint --format agent --config oxlint.config.ts budget
    just lint-eslint

# Check Tailwind classes and React Hooks; pass --fix to apply safe ESLint fixes.
[positional-arguments]
@lint-eslint *args:
    ./node_modules/.bin/eslint "src/**/*.{ts,tsx}" "$@"
alias lint-hooks := lint-eslint

@typecheck:
    ./node_modules/.bin/tsc --noEmit

[positional-arguments]
@test *args:
    ./node_modules/.bin/vitest run "$@"

[positional-arguments]
@test-node *args:
    ./node_modules/.bin/vitest run --project node "$@"

[positional-arguments]
@test-ui *args:
    ./node_modules/.bin/vitest run --project ui "$@"

[positional-arguments]
@test-watch *args:
    ./node_modules/.bin/vitest "$@"

@build:
    ./node_modules/.bin/vite build

@check: format-check lint typecheck test build

# Exercise the MCP task guard, namespace refresh and render receipt state without Blender.
[group("model")]
@blender-workflow-tests:
    cd "{{repo_root}}" && uv run python model/scripts/test_blender_workflow.py
