set default-list := true
set dotenv-load := false
set fallback := true
set positional-arguments

import "../node_modules/@prb/devkit/just/settings.just"

oxfmt := "na oxfmt --config ../oxfmt.config.ts"
prose_files := '"**/*.{md,yml,yaml}"'

@dev *args:
    na vite "$@"

@preview *args:
    na vite preview "$@"

@format: format-prose
    {{ oxfmt }} --write .

@format-prose:
    na prettier --write {{ prose_files }}

@format-check: format-prose-check
    {{ oxfmt }} --check .

@format-prose-check:
    na prettier --check {{ prose_files }}

@lint: lint-eslint
    na oxlint --format agent --config ../oxlint.config.ts .

# Check Tailwind classes and React Hooks in `src`; pass paths to narrow it or --fix to apply safe ESLint fixes.
@lint-eslint *args:
    na eslint "$@"

@typecheck:
    na tsc --noEmit

@test *args:
    na vitest run "$@"

# Run the full suite with token-efficient agent output; accepts file filters and Vitest flags.
@test-agent *args:
    na vitest run --reporter=agent "$@"

@test-node *args:
    na vitest run --project node "$@"

@test-ui *args:
    na vitest run --project ui "$@"

@test-watch *args:
    na vitest "$@"

@build:
    na vite build

@check: typecheck test

# Edit one cost item in `data/project.json` with schema validation and an atomic write; run with no arguments for usage.
@cost *args:
    bun src/server/cost-cli.ts "$@"
