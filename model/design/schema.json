    "structural_member": {
      "description": "Concept reinforced-concrete frame member (column or beam, absolute z bounds) or a structural grid axis (no level or geometry).",
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["column", "beam", "axis"]
        },
        "mark": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "material_id": {
          "$ref": "#/$defs/id"
        },
        "level_id": {
          "$ref": "#/$defs/id"
        },
        "center": {
          "$ref": "#/$defs/point2"
        },
        "section_m": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/positive"
            },
            {
              "$ref": "#/$defs/positive"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "start": {
          "$ref": "#/$defs/point2"
        },
        "end": {
          "$ref": "#/$defs/point2"
        },
        "width_m": {
          "$ref": "#/$defs/positive"
        },
        "bottom_z_m": {
          "$ref": "#/$defs/number"
        },
        "top_z_m": {
          "$ref": "#/$defs/number"
        },
        "placement": {
          "enum": ["in-wall", "upturned", "flush", "downstand", "band", "edge"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["x", "y"],
          "description": "x: an axis at constant x, labelled with a number; y: an axis at constant y, labelled with a letter."
        },
        "position": {
          "$ref": "#/$defs/number"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "column"
              }
            }
          },
          "then": {
            "required": [
              "mark",
              "material_id",
              "level_id",
              "center",
              "section_m",
              "bottom_z_m",
              "top_z_m"
            ],
            "properties": {
              "start": false,
              "end": false,
              "width_m": false,
              "placement": false,
              "label": false,
              "direction": false,
              "position": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "beam"
              }
            }
          },
          "then": {
            "required": [
              "mark",
              "material_id",
              "level_id",
              "start",
              "end",
              "width_m",
              "bottom_z_m",
              "top_z_m",
              "placement"
            ],
            "properties": {
              "center": false,
              "section_m": false,
              "label": false,
              "direction": false,
              "position": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "axis"
              }
            }
          },
          "then": {
            "required": ["label", "direction", "position"],
            "properties": {
              "mark": false,
              "material_id": false,
              "level_id": false,
              "center": false,
              "section_m": false,
              "start": false,
              "end": false,
              "width_m": false,
              "bottom_z_m": false,
              "top_z_m": false,
              "placement": false
            }
          }
        }
      ]
    },
    "semanticRef": {
      "type": "object",
      "required": ["entity_id", "requirements"],
      "properties": {
        "entity_id": {
